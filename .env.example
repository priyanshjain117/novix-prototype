# Default is deterministic mock mode; no API key is needed.
LLM_MODE=mock

# Used only when LLM_MODE=real.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=8

# Edge execution mode: mock (default, deterministic, no model needed) or ollama.
EDGE_LLM_MODE=mock

# Used only when EDGE_LLM_MODE=ollama. The model must be pulled on the Ollama
# host beforehand (e.g. `ollama pull llama3.2`) - this is not done automatically.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=15
